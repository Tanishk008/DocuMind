# DocuMind AI — environment variable reference
#
# Local dev: copy the backend block into `backend/.env.local`, and the frontend block into
# `frontend/.env.local`.
# Deployed: set the backend block in Render's environment settings and the frontend block in
# Vercel's. Never commit real values — `.env.local` is gitignored.

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND (Express on Render)
# ─────────────────────────────────────────────────────────────────────────────

# --- REQUIRED: Supabase Postgres ---
# Use the IPv4 *transaction pooler* connection string (Supabase Dashboard →
# Project Settings → Database → Connection String → Transaction pooler).
# The direct `db.<ref>.supabase.co` host is IPv6-only and is unreachable from most hosts.
# Remember to URL-encode special characters in the password (e.g. `#` becomes `%23`).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- REQUIRED: Supabase Storage (figures extracted from PDFs / DOCX) ---
# Diagrams pulled out of uploaded documents are stored in the public `extracted-images`
# bucket and referenced by absolute URL, so the Vercel frontend can load them without
# sharing a filesystem with the backend. Without these two vars the text extraction still
# works, but figures are silently dropped from answers.
# SUPABASE_SECRET_KEY is the `sb_secret_...` key from Project Settings → API keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# --- REQUIRED: Groq (AI answers) ---
# Get a key at https://console.groq.com/keys
# _2 and _3 are optional extras; the backend rotates to the next key when one is rate-limited.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# --- REQUIRED: session/token signing ---
# Use long random strings. SESSION_SECRET falls back to JWT_SECRET if unset.
JWT_SECRET=replace_with_a_long_random_string
SESSION_SECRET=replace_with_a_long_random_string

# --- Admin account (hardcoded login, not stored in the users table) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# --- Email delivery (OTP + contact form) ---
# At least one provider must work, otherwise OTP requests return a 502.
# Tried in order: Resend → Brevo → Gmail SMTP.
# EMAIL_PASS is a Gmail *app password* (not the account password).
EMAIL_PASS=your_gmail_app_password
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# --- OPTIONAL: fallback model provider, used when Groq is rate-limited ---
OPENROUTER_API_KEY=

# --- Server port ---
# Render injects PORT automatically; this is only for local dev.
PORT=5001

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Next.js on Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the backend. Defaults to http://localhost:5001 when unset.
# In Vercel, set this to your Render service URL, e.g. https://documind-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001
